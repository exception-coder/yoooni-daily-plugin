{
  "description": "Codex and Claude Code hooks for daily team-tool updates and plugin-version checks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-autoupdate.js\"", "async": false }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-plugin-version-stale.js\"", "async": false }
        ]
      }
    ]
  }
}
